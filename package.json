{
  "name": "vss-bridge",
  "displayName": "VSS Bridge (Visual SourceSafe)",
  "description": "Dreamweaver-style Visual SourceSafe integration for VS Code. Asks 'View or Check Out?' when you open a file, and adds Check In, Undo Checkout, Get Latest and History commands, multi-file check in/out, and Explorer badges for checked-out files. Developed by Moiz Bohra.",
  "version": "0.2.4",
  "publisher": "MoizBohra",
  "author": {
    "name": "Moiz Bohra"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "vss",
    "sourcesafe",
    "visual sourcesafe",
    "checkout",
    "checkin",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "icon": "icon.png",
  "contributes": {
    "configuration": {
      "title": "VSS Bridge (Visual SourceSafe)",
      "properties": {
        "vssBridge.ssExePath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Microsoft Visual SourceSafe\\ss.exe",
          "description": "Full path to ss.exe (Visual SourceSafe command line utility). Example: C:\\Program Files (x86)\\Microsoft Visual SourceSafe\\ss.exe"
        },
        "vssBridge.databasePath": {
          "type": "string",
          "default": "",
          "description": "Path to the FOLDER that contains srcsafe.ini of your VSS database (this becomes the SSDIR environment variable). Example: \\\\vssserver\\vss\\  or  D:\\VSS\\MyDatabase"
        },
        "vssBridge.username": {
          "type": "string",
          "default": "",
          "description": "VSS username used for checkout / checkin operations."
        },
        "vssBridge.password": {
          "type": "string",
          "default": "",
          "description": "VSS password. WARNING: stored in plain text in settings.json. Prefer workspace settings and protect the file, or leave empty if your account has no password."
        },
        "vssBridge.vssProject": {
          "type": "string",
          "default": "$/",
          "description": "VSS project path mapped to the first workspace folder. Example: $/MyProject/webapp/api - so that C:\\dev\\api\\test.php maps to $/MyProject/webapp/api/test.php"
        },
        "vssBridge.mappings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "local": {
                "type": "string",
                "description": "Local folder, relative to the workspace folder (e.g. webapp\\\\api) or an absolute path"
              },
              "vss": {
                "type": "string",
                "description": "VSS project it maps to (e.g. $/MyProject/webapp/api)"
              }
            }
          },
          "description": "Folder-level VSS mappings for when the local folder layout does not mirror the VSS tree. Deepest match wins; everything else uses vssBridge.vssProject. Example: [ { \"local\": \"webapp\\\\api\", \"vss\": \"$/MyProject/webapp/api\" } ]"
        },
        "vssBridge.promptOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When you open a file, ask 'Check Out or View only?' (Dreamweaver style). Files that are already checked out by you are skipped automatically."
        },
        "vssBridge.ignoredFileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "exe",
            "dll",
            "pdb",
            "obj",
            "bin",
            "cache",
            "suo",
            "ncb",
            "sdf",
            "opensdf",
            "log",
            "tmp",
            "zip",
            "rar",
            "7z",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "bmp",
            "ico",
            "pdf",
            "mp3",
            "mp4",
            "avi",
            "wav"
          ],
          "description": "File extensions that should never trigger the View/Checkout prompt (binaries, build outputs, media)."
        },
        "vssBridge.autoGetWhenMissing": {
          "type": "boolean",
          "default": true,
          "description": "If the local file does not exist yet (fresh workspace), automatically run 'Get Latest' before showing the View/Checkout prompt."
        },
        "vssBridge.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Maximum time in seconds to wait for each ss.exe operation before aborting it."
        },
        "vssBridge.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show VSS status of the active file (Checked in / Checked out by ...) in the status bar."
        },
        "vssBridge.explorerDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show a ✓ badge in the Explorer on files checked out in VSS (green = by you, red = by someone else; hover for the name). Reads one VSS folder at a time, only for folders you have open."
        },
        "vssBridge.explorerRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often the Explorer badges of visible folders are re-read from VSS, to pick up other people's checkouts. 0 = only after your own VSS actions and \"VSS: Refresh Status\"."
        },
        "vssBridge.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "azure",
            "gemini"
          ],
          "enumDescriptions": [
            "OpenAI, or any OpenAI-compatible API: OpenRouter, Groq, DeepSeek, Ollama, LM Studio...",
            "Anthropic (Claude)",
            "Azure OpenAI",
            "Google Gemini"
          ],
          "default": "openai",
          "description": "AI used by the ✨ button of the check-in comment box: it reads what you changed since checkout and writes the comment. Your changed code is sent to this provider. The API key is set with \"VSS: Set AI API Key\" and stored encrypted by VS Code, not in settings.json."
        },
        "vssBridge.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "API base URL. Empty = the provider's own (https://api.openai.com/v1, https://api.anthropic.com, https://generativelanguage.googleapis.com/v1beta). Examples: http://localhost:11434/v1 (Ollama), https://openrouter.ai/api/v1. Azure: paste the full chat completions URL from the Azure portal, e.g. https://myres.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2024-10-21"
        },
        "vssBridge.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model name, e.g. gpt-4o-mini, claude-haiku-5-5, gemini-2.5-flash, llama3.1. Azure: the deployment name (can stay empty when the endpoint URL already names the deployment)."
        }
      }
    },
    "commands": [
      {
        "command": "vssBridge.checkout",
        "title": "VSS: Check Out",
        "category": "VSS Bridge",
        "icon": "$(pencil)"
      },
      {
        "command": "vssBridge.checkin",
        "title": "VSS: Check In",
        "category": "VSS Bridge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vssBridge.checkinMine",
        "title": "VSS: Check In My Checkouts...",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.checkoutSearchResults",
        "title": "VSS: Check Out All Search Results",
        "category": "VSS Bridge",
        "icon": "$(pencil)"
      },
      {
        "command": "vssBridge.checkinSearchResults",
        "title": "VSS: Check In All Search Results",
        "category": "VSS Bridge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vssBridge.sortCheckouts",
        "title": "VSS: Sort Checkouts (Date / User / Default)...",
        "category": "VSS Bridge",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "vssBridge.quickMenu",
        "title": "VSS: Actions for This File...",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.undoCheckout",
        "title": "VSS: Undo Checkout",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.getLatest",
        "title": "VSS: Get Latest Version",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.history",
        "title": "VSS: Show History",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.openPrompt",
        "title": "VSS: View or Check Out...",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.refreshStatus",
        "title": "VSS: Refresh Status",
        "category": "VSS Bridge",
        "icon": "$(refresh)"
      },
      {
        "command": "vssBridge.configure",
        "title": "VSS: Open Settings",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.testConnection",
        "title": "VSS: Test Connection & Mapping",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.showLog",
        "title": "VSS: Show Output Log",
        "category": "VSS Bridge"
      },
      {
        "command": "vssBridge.setAiKey",
        "title": "VSS: Set AI API Key",
        "category": "VSS Bridge"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vssBridge.checkouts",
          "name": "VSS Checkouts",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "vssBridge.checkout",
          "group": "vss@1"
        },
        {
          "command": "vssBridge.checkin",
          "group": "vss@2"
        },
        {
          "command": "vssBridge.checkinMine",
          "group": "vss@2"
        },
        {
          "command": "vssBridge.undoCheckout",
          "group": "vss@3"
        },
        {
          "command": "vssBridge.getLatest",
          "group": "vss@4"
        },
        {
          "command": "vssBridge.history",
          "group": "vss@5",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "vssBridge.openPrompt",
          "group": "vss@6",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "vssBridge.checkout",
          "group": "vss@1"
        },
        {
          "command": "vssBridge.checkin",
          "group": "vss@2"
        },
        {
          "command": "vssBridge.undoCheckout",
          "group": "vss@3"
        },
        {
          "command": "vssBridge.getLatest",
          "group": "vss@4"
        },
        {
          "command": "vssBridge.history",
          "group": "vss@5"
        },
        {
          "command": "vssBridge.openPrompt",
          "group": "vss@6"
        }
      ],
      "editor/title": [
        {
          "command": "vssBridge.checkout",
          "group": "navigation@90",
          "when": "resourceScheme == file"
        },
        {
          "command": "vssBridge.checkin",
          "group": "navigation@91",
          "when": "resourceScheme == file"
        }
      ],
      "view/title": [
        {
          "command": "vssBridge.checkoutSearchResults",
          "group": "navigation@50",
          "when": "view == workbench.view.search"
        },
        {
          "command": "vssBridge.checkinSearchResults",
          "group": "navigation@51",
          "when": "view == workbench.view.search"
        },
        {
          "command": "vssBridge.sortCheckouts",
          "group": "navigation@1",
          "when": "view == vssBridge.checkouts"
        },
        {
          "command": "vssBridge.refreshStatus",
          "group": "navigation@2",
          "when": "view == vssBridge.checkouts"
        }
      ],
      "view/item/context": [
        {
          "command": "vssBridge.checkin",
          "group": "inline",
          "when": "view == vssBridge.checkouts && viewItem == mine"
        },
        {
          "command": "vssBridge.checkin",
          "group": "vss@1",
          "when": "view == vssBridge.checkouts && viewItem == mine"
        },
        {
          "command": "vssBridge.undoCheckout",
          "group": "vss@2",
          "when": "view == vssBridge.checkouts && viewItem == mine"
        },
        {
          "command": "vssBridge.history",
          "group": "vss@3",
          "when": "view == vssBridge.checkouts"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vssBridge.checkout",
        "key": "ctrl+alt+v o"
      },
      {
        "command": "vssBridge.checkin",
        "key": "ctrl+alt+v i"
      },
      {
        "command": "vssBridge.undoCheckout",
        "key": "ctrl+alt+v u"
      },
      {
        "command": "vssBridge.getLatest",
        "key": "ctrl+alt+v g"
      },
      {
        "command": "vssBridge.history",
        "key": "ctrl+alt+v h"
      },
      {
        "command": "vssBridge.openPrompt",
        "key": "ctrl+alt+v p"
      },
      {
        "command": "vssBridge.checkinMine",
        "key": "ctrl+alt+v m"
      },
      {
        "command": "vssBridge.checkoutSearchResults",
        "key": "ctrl+alt+v shift+o"
      },
      {
        "command": "vssBridge.checkinSearchResults",
        "key": "ctrl+alt+v shift+i"
      },
      {
        "command": "vssBridge.checkouts.focus",
        "key": "ctrl+alt+v c"
      },
      {
        "command": "vssBridge.sortCheckouts",
        "key": "ctrl+alt+v s"
      },
      {
        "command": "vssBridge.refreshStatus",
        "key": "ctrl+alt+v r"
      },
      {
        "command": "vssBridge.quickMenu",
        "key": "ctrl+alt+v v"
      },
      {
        "command": "vssBridge.testConnection",
        "key": "ctrl+alt+v t"
      },
      {
        "command": "vssBridge.showLog",
        "key": "ctrl+alt+v l"
      },
      {
        "command": "vssBridge.configure",
        "key": "ctrl+alt+v ,"
      }
    ],
    "colors": [
      {
        "id": "vssBridge.checkedOutByMe",
        "description": "Explorer color of files you have checked out in VSS.",
        "defaults": {
          "dark": "gitDecoration.addedResourceForeground",
          "light": "gitDecoration.addedResourceForeground",
          "highContrast": "gitDecoration.addedResourceForeground"
        }
      },
      {
        "id": "vssBridge.checkedOutByOther",
        "description": "Explorer color of files someone else has checked out in VSS.",
        "defaults": {
          "dark": "gitDecoration.deletedResourceForeground",
          "light": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground"
        }
      }
    ]
  },
  "scripts": {
    "test": "node test/parse.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moizbohra52/vss-bridge.git"
  }
}